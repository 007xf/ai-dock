#!name=Singapore SGP1 | WebRTC 防泄漏（严格模式）
#!desc=叠加 2026-10-18 SGP1 智能分流；保留局域网直连，拒绝 TUN 捕获的其他 UDP（含 STUN/QUIC）；不修改 DNS、IPv6、广告规则与节点。可能影响实时音视频及游戏。
# For: Singapore_SGP1_Smart_DNS_IPv4.conf (2026-10-18)
# Independent module; do NOT replace base .conf
# Does not govern traffic that bypasses or is excluded from iOS VPN.
# Also enable Shadowrocket > Settings > UDP > Disable STUN.

[General]
compatibility-mode = 3
udp-policy-not-supported-behaviour = REJECT

[Rule]
# Common STUN/TURN destination ports, including TCP fallback
DOMAIN-KEYWORD,stun,REJECT-NO-DROP
DST-PORT,3478-3481,REJECT-NO-DROP
DST-PORT,5349,REJECT-NO-DROP
DST-PORT,19302-19309,REJECT-NO-DROP

# Preserve private unicast LAN routes
IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
IP-CIDR,169.254.0.0/16,DIRECT,no-resolve
IP-CIDR,127.0.0.0/8,DIRECT,no-resolve

# Strictly block all other UDP ports; regular TCP/DoH still follow base config
AND,((PROTOCOL,UDP),(DST-PORT,1-65535)),REJECT-NO-DROP
